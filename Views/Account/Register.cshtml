@{
    ViewData["Title"] = "Регистрация";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">🚀 Регистрация</h3>
                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <input name="fullName" class="form-control" placeholder="Ваше имя" required />
                        </div>
                        <div class="mb-3">
                            <input name="email" type="email" class="form-control" placeholder="Email" required />
                        </div>
                        <div class="mb-3">
                            <input name="password" type="password" class="form-control" placeholder="Пароль" required />
                        </div>
                        <div class="mb-3">
                            <select name="role" class="form-select">
                                <option value="Client">Я клиент</option>
                                <option value="Courier">Я курьер</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold">Зарегистрироваться</button>
                    </form>
                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="Login">Уже есть аккаунт? Войти</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>