@{
    ViewData["Title"] = "Вход";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/img/aotugo.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="aitugo" />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #fff; min-height: 100vh; }
        .header { padding: 20px; display: flex; align-items: center; gap: 16px; border-bottom: 1px solid #f0f0f0; }
        .back-btn { font-size: 22px; cursor: pointer; color: #000; text-decoration: none; }
        .brand { font-family: 'Pacifico', cursive; font-size: 22px; color: #000; }
        .brand span { background: #FFD700; border-radius: 8px; padding: 2px 8px; }
        .container { padding: 32px 24px; max-width: 480px; margin: 0 auto; }
        h2 { font-size: 26px; font-weight: 700; margin-bottom: 24px; }
        .tabs { display: flex; background: #f5f5f5; border-radius: 12px; padding: 4px; margin-bottom: 24px; }
        .tab { flex: 1; text-align: center; padding: 10px; border-radius: 10px; cursor: pointer; font-weight: 500; color: #999; }
        .tab.active { background: #fff; color: #000; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
        .input-group { margin-bottom: 16px; }
        input { width: 100%; padding: 16px; border: 1.5px solid #e0e0e0; border-radius: 12px; font-size: 16px; outline: none; transition: border 0.2s; }
        input:focus { border-color: #000; }
        .divider { text-align: center; color: #999; margin: 20px 0; font-size: 14px; }
        .social-btns { display: flex; justify-content: center; gap: 24px; margin-bottom: 24px; }
        .social-btn { width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid #e0e0e0; display: flex; align-items: center; justify-content: center; font-size: 22px; cursor: pointer; }
        .btn-main { width: 100%; padding: 16px; background: #1a1a1a; color: #fff; border: none; border-radius: 14px; font-size: 17px; font-weight: 600; cursor: pointer; margin-bottom: 12px; }
        .btn-secondary { width: 100%; padding: 16px; background: #f5f5f5; color: #000; border: none; border-radius: 14px; font-size: 16px; font-weight: 500; cursor: pointer; margin-bottom: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .btn-outline { width: 100%; padding: 16px; background: #fff; color: #000; border: 1.5px solid #e0e0e0; border-radius: 14px; font-size: 16px; font-weight: 500; cursor: pointer; text-align: center; display: block; text-decoration: none; }
        .error { color: red; font-size: 14px; margin-bottom: 12px; }
    </style>
</head>
<body>
    <div class="header">
        <a href="javascript:void(0)" onclick="history.back()" class="back-btn">←</a>
        <div class="brand"><span>aitugo</span></div>
    </div>
    <div class="container">
        <h2>Войдите с ID</h2>
        <div class="tabs">
            <div class="tab active">Почта</div>
            <div class="tab">Телефон</div>
        </div>
        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error">Неверный email или пароль</div>
            }
            <div id="tab-email">
                <div class="input-group">
                    <input name="email" type="email" placeholder="Логин или email" required />
                </div>
                <div class="input-group">
                    <input name="password" type="password" placeholder="Пароль" required />
                </div>
            </div>
            <div id="tab-phone" style="display:none;">
                <div class="input-group">
                    <input type="tel" placeholder="+996 ___ ___ ___" />
                </div>
            </div>
            <div class="divider">или войдите через</div>
            <div class="social-btns">
                <div class="social-btn">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="black"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                </div>
                <div class="social-btn" style="font-weight:700; font-size:18px; color:#4285F4;">G</div>
                <div class="social-btn" style="font-weight:900; font-size:16px;">𝕏</div>
            </div>
            <button type="submit" class="btn-main">Далее</button>
        </form>
        <button class="btn-secondary">☞ По лицу или отпечатку</button>
        <a asp-controller="Account" asp-action="Register" class="btn-outline">Создать ID</a>
    </div>
    <script>
        document.querySelectorAll('.tab').forEach((tab, i) => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById('tab-email').style.display = i === 0 ? 'block' : 'none';
                document.getElementById('tab-phone').style.display = i === 1 ? 'block' : 'none';
            });
        });
    </script>
</body>
</html>