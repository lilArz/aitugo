@model YandexGoClone.Models.AppUser
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f5; }
        .header { background: #fff; padding: 16px 20px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #f0f0f0; }
        .back-btn { font-size: 22px; text-decoration: none; color: #000; }
        .profile-top { background: #fff; padding: 32px 20px 24px; text-align: center; margin-bottom: 12px; }
        .avatar-big { width: 80px; height: 80px; background: #f0f0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 36px; color: #999; }
        .profile-name { font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .profile-email { font-size: 14px; color: #888; margin-top: 4px; }
        .quick-btns { display: flex; justify-content: center; gap: 24px; margin-top: 20px; }
        .quick-btn { text-align: center; cursor: pointer; }
        .quick-btn-icon { width: 48px; height: 48px; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 6px; font-size: 20px; }
        .quick-btn-label { font-size: 12px; color: #555; }
        .section { background: #fff; border-radius: 16px; margin: 0 16px 12px; overflow: hidden; }
        .menu-item { display: flex; align-items: center; gap: 14px; padding: 16px; border-bottom: 1px solid #f5f5f5; cursor: pointer; text-decoration: none; color: #000; }
        .menu-item:last-child { border-bottom: none; }
        .menu-icon { width: 36px; height: 36px; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
        .menu-text { flex: 1; }
        .menu-title { font-size: 15px; font-weight: 500; }
        .menu-sub { font-size: 13px; color: #888; margin-top: 2px; }
        .menu-arrow { color: #ccc; font-size: 18px; }
        .menu-badge { background: #22c55e; color: #fff; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 700; }
        .logout-btn { display: block; margin: 0 16px 32px; padding: 16px; background: #fff; border-radius: 16px; text-align: center; color: #ff3b30; font-weight: 600; font-size: 16px; text-decoration: none; border: none; width: calc(100% - 32px); cursor: pointer; }
    </style>
</head>
<body>
    <div class="header">
        <a onclick="history.back()" class="back-btn">←</a>
    </div>

    <div class="profile-top">
        <div class="avatar-big">👤</div>
        <div class="profile-name">@Model.FullName ➤</div>
        <div class="profile-email">@Model.Email</div>
        <div class="quick-btns">
            <div class="quick-btn" onclick="window.location.href='/Order/MyOrders'">
                <div class="quick-btn-icon">🕐</div>
                <div class="quick-btn-label">Заказы</div>
            </div>
            <div class="quick-btn">
                <div class="quick-btn-icon">🎧</div>
                <div class="quick-btn-label">Поддержка</div>
            </div>
            <div class="quick-btn">
                <div class="quick-btn-icon">📍</div>
                <div class="quick-btn-label">Адреса</div>
            </div>
            <div class="quick-btn">
                <div class="quick-btn-icon">⚙️</div>
                <div class="quick-btn-label">Настройки</div>
            </div>
        </div>
    </div>

    <div style="background:#f5f5f5; padding:10px 16px; font-size:13px; color:#888; margin-bottom:4px;">
        ↩ Главные разделы теперь здесь
    </div>

    <div class="section">
        <a class="menu-item">
            <div class="menu-icon">%</div>
            <div class="menu-text">
                <div class="menu-title">Скидки и подарки</div>
                <div class="menu-sub">Ввести промокод</div>
            </div>
            <span class="menu-arrow">›</span>
        </a>
        <a class="menu-item">
            <div class="menu-icon">💳</div>
            <div class="menu-text">
                <div class="menu-title">Способы оплаты</div>
                <div class="menu-sub">Наличные</div>
            </div>
            <span class="menu-badge">💵</span>
            <span class="menu-arrow">›</span>
        </a>
    </div>

    <div class="section">
        <a class="menu-item">
            <div class="menu-icon">💼</div>
            <div class="menu-text">
                <div class="menu-title">Бизнес-аккаунт</div>
            </div>
            <span class="menu-arrow">›</span>
        </a>
        <a class="menu-item">
            <div class="menu-icon">👥</div>
            <div class="menu-text">
                <div class="menu-title">Семейный аккаунт</div>
            </div>
            <span class="menu-arrow">›</span>
        </a>
        <a class="menu-item">
            <div class="menu-icon">🛡</div>
            <div class="menu-text">
                <div class="menu-title">Безопасность</div>
            </div>
            <span class="menu-arrow">›</span>
        </a>
        <a class="menu-item">
            <div class="menu-icon">ℹ️</div>
            <div class="menu-text">
                <div class="menu-title">Информация</div>
            </div>
            <span class="menu-arrow">›</span>
        </a>
    </div>

    <a href="/Account/Logout" class="logout-btn">Выйти из аккаунта</a>
</body>
</html>