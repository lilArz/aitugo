@model List<YandexGoClone.Models.Order>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f5; }
        .header { background: #1a1a1a; padding: 16px 20px; display: flex; align-items: center; gap: 16px; }
        .back-btn { font-size: 22px; text-decoration: none; color: #FFD700; }
        .header h1 { font-family: 'Pacifico', cursive; font-size: 22px; color: #FFD700; }
        .online-badge { margin-left: auto; background: #22c55e; color: #fff; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; }
        .container { padding: 16px; }
        .empty { text-align: center; padding: 60px 20px; color: #888; }
        .empty-icon { font-size: 64px; margin-bottom: 16px; }
        .order-card { background: #fff; border-radius: 16px; padding: 16px; margin-bottom: 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }
        .order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .order-id { font-size: 13px; color: #888; }
        .price { font-size: 18px; font-weight: 800; color: #000; }
        .addr-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
        .addr-dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
        .dot-from { background: #FFD700; border: 2px solid #000; }
        .dot-to { background: #000; }
        .addr-text { font-size: 14px; color: #333; }
        .client-row { display: flex; align-items: center; gap: 8px; margin: 10px 0; padding: 10px; background: #f7f7f7; border-radius: 12px; }
        .client-avatar { width: 32px; height: 32px; background: #FFD700; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; }
        .client-name { font-size: 14px; font-weight: 600; }
        .btn-accept { width: 100%; padding: 14px; background: #FFD700; border: none; border-radius: 14px; font-size: 16px; font-weight: 700; cursor: pointer; margin-top: 12px; }
        .stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 16px; }
        .stat { background: #fff; border-radius: 14px; padding: 14px; text-align: center; }
        .stat-num { font-size: 22px; font-weight: 800; }
        .stat-label { font-size: 11px; color: #888; margin-top: 2px; }
    </style>
</head>
<body>
    <div class="header">
        <a href="/" class="back-btn">←</a>
        <h1>aitugo</h1>
        <span class="online-badge">● Онлайн</span>
    </div>

    <div class="container">
        <div class="stats">
            <div class="stat">
                <div class="stat-num">@Model.Count</div>
                <div class="stat-label">Новых</div>
            </div>
            <div class="stat">
                <div class="stat-num">⭐ 4.9</div>
                <div class="stat-label">Рейтинг</div>
            </div>
            <div class="stat">
                <div class="stat-num">💰</div>
                <div class="stat-label">Баланс</div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty">
                <div class="empty-icon">🛵</div>
                <div style="font-size:18px; font-weight:600; color:#333;">Новых заказов нет</div>
                <div style="margin-top:8px;">Ожидайте новых заказов...</div>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div class="order-card">
                    <div class="order-header">
                        <span class="order-id">Заказ #@order.Id • @order.CreatedAt.ToString("HH:mm")</span>
                        <span class="price">@order.Price сом</span>
                    </div>
                    <div class="addr-row">
                        <div class="addr-dot dot-from"></div>
                        <div class="addr-text">@order.FromAddress</div>
                    </div>
                    <div class="addr-row">
                        <div class="addr-dot dot-to"></div>
                        <div class="addr-text">@order.ToAddress</div>
                    </div>
                    @if (order.Client != null)
                    {
                        <div class="client-row">
                            <div class="client-avatar">@order.Client.FullName.Substring(0,1).ToUpper()</div>
                            <div class="client-name">@order.Client.FullName</div>
                        </div>
                    }
                    <form method="post" action="/Order/AcceptOrder">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <button type="submit" class="btn-accept">🛵 Принять заказ</button>
                    </form>
                </div>
            }
        }
    </div>

    <script>
        // Автообновление каждые 10 сек
        setTimeout(() => location.reload(), 10000);
    </script>
</body>
</html>