@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #fff; height: 100vh; display: flex; flex-direction: column; }
        #map { flex: 1; min-height: 55vh; }
        .back-btn { position: absolute; top: 20px; left: 16px; z-index: 1000; width: 42px; height: 42px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); cursor: pointer; text-decoration: none; color: #000; }
        .locate-btn { position: absolute; top: 20px; right: 16px; z-index: 1000; width: 42px; height: 42px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); cursor: pointer; }
        .courier-badge { position: absolute; top: 80px; left: 50%; transform: translateX(-50%); z-index: 1000; background: #fff; border-radius: 14px; padding: 10px 16px; display: flex; align-items: center; gap: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
        .courier-badge-icon { width: 36px; height: 36px; background: #333; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px; }
        .courier-badge-text { font-size: 14px; font-weight: 600; }
        .courier-badge-sub { font-size: 12px; color: #888; }
        .bottom-sheet { background: #fff; border-radius: 24px 24px 0 0; padding: 20px; box-shadow: 0 -4px 20px rgba(0,0,0,0.1); }
        .sheet-title { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
        .sheet-icon { width: 44px; height: 44px; background: #ff4444; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
        .sheet-title h2 { font-size: 22px; font-weight: 700; }
        .address-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f0f0f0; }
        .addr-icon { font-size: 20px; color: #888; }
        .addr-input { flex: 1; border: none; outline: none; font-size: 15px; color: #333; background: transparent; }
        .addr-input::placeholder { color: #bbb; }
        .delivery-types { display: flex; gap: 10px; margin: 16px 0; overflow-x: auto; padding-bottom: 4px; }
        .dtype { border: 2px solid #e0e0e0; border-radius: 14px; padding: 10px 14px; cursor: pointer; min-width: 90px; text-align: center; transition: all 0.2s; }
        .dtype.active { border-color: #000; background: #f5f5f5; }
        .dtype-icon { font-size: 22px; }
        .dtype-time { font-size: 12px; color: #888; }
        .dtype-label { font-size: 13px; font-weight: 600; }
        .dtype-price { font-size: 12px; color: #555; }
        .holiday-banner { background: #f7f7f7; border-radius: 14px; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; cursor: pointer; }
        .holiday-text { font-size: 14px; font-weight: 600; }
        .holiday-sub { font-size: 12px; color: #888; }
        .btn-order { width: 100%; padding: 17px; background: #FFD700; color: #000; border: none; border-radius: 16px; font-size: 17px; font-weight: 700; cursor: pointer; }
        .btn-row { display: flex; align-items: center; gap: 12px; }
        .btn-settings { width: 50px; height: 50px; background: #f5f5f5; border: none; border-radius: 14px; font-size: 20px; cursor: pointer; }
    </style>
</head>
<body>
    <div style="position:relative; flex:1;">
        <div id="map"></div>
        <a href="/" class="back-btn">←</a>
        <div class="locate-btn" onclick="locateMe()">◎</div>
        <div class="courier-badge">
            <div class="courier-badge-icon">📦</div>
            <div>
                <div class="courier-badge-text">Подача</div>
                <div class="courier-badge-sub">~13 мин</div>
            </div>
        </div>
    </div>

    <div class="bottom-sheet">
        <div class="sheet-title">
            <div class="sheet-icon">📦</div>
            <h2>Доставка</h2>
        </div>
        <form method="post" action="/Order/CreateOrder">
            <div class="address-row">
                <span class="addr-icon">📍</span>
                <input class="addr-input" name="fromAddress" placeholder="Откуда забрать" required />
            </div>
            <div class="address-row">
                <span class="addr-icon">🏁</span>
                <input class="addr-input" name="toAddress" placeholder="Куда доставить" required />
            </div>
            <input type="hidden" name="deliveryType" id="deliveryType" value="moto" />
            <div class="delivery-types">
                <div class="dtype active" onclick="selectType(this,'moto')">
                    <div class="dtype-icon">🛵</div>
                    <div class="dtype-time">13 мин</div>
                    <div class="dtype-label">На мото</div>
                    <div class="dtype-price">от 60 сом</div>
                </div>
                <div class="dtype" onclick="selectType(this,'delivery')">
                    <div class="dtype-icon">🚖</div>
                    <div class="dtype-time">13 мин</div>
                    <div class="dtype-label">Доставка</div>
                    <div class="dtype-price">от 60 сом</div>
                </div>
                <div class="dtype" onclick="selectType(this,'cargo')">
                    <div class="dtype-icon">🚚</div>
                    <div class="dtype-time">6 мин</div>
                    <div class="dtype-label">Грузовой</div>
                    <div class="dtype-price">от 289 сом</div>
                </div>
            </div>
            <div class="holiday-banner">
                <div>
                    <div class="holiday-text">Доставка в праздники</div>
                    <div class="holiday-sub">Поможем отправить подарки близким</div>
                </div>
                <span>🎁 ›</span>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn-order">Перейти к форме заказа</button>
                <button type="button" class="btn-settings">⚙</button>
            </div>
        </form>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([42.87, 74.59], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

        var courierMarker = L.marker([42.87, 74.59], {
            icon: L.divIcon({ className: '', html: '<div style="background:#333;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;font-size:18px;">🛵</div>', iconSize: [36,36] })
        }).addTo(map);

        // Симуляция движения курьера
        var lat = 42.87, lng = 74.59;
        setInterval(() => {
            lat += (Math.random() - 0.5) * 0.001;
            lng += (Math.random() - 0.5) * 0.001;
            courierMarker.setLatLng([lat, lng]);
        }, 3000);

        function locateMe() {
            navigator.geolocation.getCurrentPosition(pos => {
                map.setView([pos.coords.latitude, pos.coords.longitude], 15);
                L.marker([pos.coords.latitude, pos.coords.longitude]).addTo(map);
            });
        }

        function selectType(el, type) {
            document.querySelectorAll('.dtype').forEach(d => d.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('deliveryType').value = type;
        }
    </script>
</body>
</html>